{
  "name": "mapvisual",
  "displayName": "MapVisual",
  "description": "Visualize embedded linker map files (GNU ld / LLVM lld) as a sortable, filterable symbol list with C++ demangling. Flash/RAM usage at a glance.",
  "version": "0.1.1",
  "publisher": "mapvisual",
  "icon": "media/icon.png",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/kali20177/map-visual.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "embedded",
    "linker map",
    "map file",
    "firmware",
    "flash",
    "ram",
    "gcc",
    "lld"
  ],
  "main": "./dist/extension.js",
  "bin": {
    "mapvisual": "./dist/cli.js"
  },
  "contributes": {
    "commands": [
      {
        "command": "mapvisual.open",
        "title": "MapVisual: Open Map File",
        "category": "MapVisual"
      },
      {
        "command": "mapvisual.diff",
        "title": "MapVisual: Compare Two Maps",
        "category": "MapVisual"
      },
      {
        "command": "mapvisual.reveal",
        "title": "MapVisual: Reveal Map View",
        "category": "MapVisual",
        "when": "false"
      },
      {
        "command": "mapvisual.openAsText",
        "title": "MapVisual: Open as Text",
        "category": "MapVisual",
        "icon": "$(file)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "mapvisual.openAsText",
          "group": "navigation",
          "when": "activeCustomEditorId == 'mapvisual.editor'"
        }
      ]
    },
    "keybindings": [
      {
        "command": "mapvisual.open",
        "key": "alt+m",
        "mac": "alt+m"
      },
      {
        "command": "mapvisual.diff",
        "key": "alt+shift+d",
        "mac": "alt+shift+d"
      }
    ],
    "customEditors": [
      {
        "viewType": "mapvisual.editor",
        "displayName": "MapVisual",
        "selector": [
          {
            "filenamePattern": "*.map"
          }
        ],
        "priority": "default"
      }
    ],
    "configuration": {
      "title": "MapVisual",
      "properties": {
        "mapvisual.demangle": {
          "type": "boolean",
          "default": true,
          "description": "Demangle C++ symbol names (built-in WASM demangler, no toolchain required)."
        },
        "mapvisual.formatOverride": {
          "type": "string",
          "enum": [
            "auto",
            "gnu-ld",
            "lld"
          ],
          "default": "auto",
          "description": "Force the map file format instead of auto-detection."
        },
        "mapvisual.clickAction": {
          "type": "string",
          "enum": [
            "locate",
            "copy"
          ],
          "enumDescriptions": [
            "Reveal the symbol's line in the raw map (opens the text pane beside the view on demand).",
            "Copy the displayed symbol name to the clipboard."
          ],
          "default": "locate",
          "description": "What a plain click on a symbol row does. Alt+click always performs the other action; double-click always reveals the line in the raw map."
        }
      }
    }
  },
  "scripts": {
    "compile": "node build.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check:coupling": "depcruise src --config .dependency-cruiser.cjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "simple-git-hooks"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "simple-git-hooks@2.14.0": true
  },
  "lint-staged": {
    "*.{ts,js,mjs,cjs}": "eslint --fix"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.85.0",
    "dependency-cruiser": "^18.4.0",
    "esbuild": "^0.25.0",
    "eslint": "^10.11.0",
    "lint-staged": "^17.5.1",
    "simple-git-hooks": "^2.14.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.70.1",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "gecko-profiler-demangle": "^0.4.0"
  }
}
